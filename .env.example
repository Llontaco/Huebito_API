# Copia este archivo a ".env" y completa los valores reales.
# NUNCA subas el archivo ".env" a git (ya está en .gitignore).

NODE_ENV=development
PORT=3000

# Connection string de Neon. Usa el endpoint "pooled" (pgbouncer) si vas a
# correr en serverless; sslmode=require es obligatorio, Neon no acepta
# conexiones sin TLS.
DATABASE_URL="dsa"

# Orígenes permitidos por CORS, separados por coma. Incluye el dominio web
# y el esquema que usa Capacitor en la app móvil.
CORS_ORIGINS="http://localhost:5173,http://localhost:4173,capacitor://localhost,http://localhost"

# Genera un secreto largo y aleatorio, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="reemplaza-esto-por-un-secreto-largo-y-aleatorio"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN_DAYS=30

# Client ID de OAuth 2.0 (tipo "Web application") desde Google Cloud Console.
GOOGLE_CLIENT_ID="xxxxxxxxxxxx.apps.googleusercontent.com"

# Opcional: solo si la API y el frontend web comparten dominio raíz
# (p.ej. api.huebito.app y app.huebito.app -> COOKIE_DOMAIN=.huebito.app)
COOKIE_DOMAIN=
