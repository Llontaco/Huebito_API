// Prisma schema — mapeado 1:1 al esquema ya existente en Neon (Huebito_JS/database/schema.sql)
// más la tabla refresh_tokens (nueva) que necesita esta API para poder rotar/revocar sesiones.

generator client {
  provider = "prisma-client-js"
  // "native" es el motor para la maquina de desarrollo (Windows). El segundo es
  // el que necesita la funcion serverless de Vercel, que corre sobre Amazon
  // Linux 2023 con OpenSSL 3; sin el, Prisma arranca en local y falla en
  // produccion con "Query engine library for current platform not found".
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
  // Necesario para declarar las vistas recetas_* de más abajo.
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Categoria {
  id      Int      @id @default(autoincrement())
  nombre  String
  slug    String   @unique
  recetas Receta[]

  @@map("categorias")
}

model Receta {
  id             Int      @id @default(autoincrement())
  categoriaId    Int      @map("categoria_id")
  nombre         String
  descripcion    String?
  ingredientes   Json     @default("[]")
  preparacion    Json     @default("[]")
  tiempoMinutos  Int?     @map("tiempo_minutos")
  dificultad     String?
  imagenAsset    String?  @map("imagen_asset")
  bebida         String?
  acompanamiento String?
  videoUrl       String?  @map("video_url")

  /// Momentos del día en que encaja: "desayuno", "almuerzo", "cena". Hoy solo
  /// lo usan las bebidas, para la ruleta de acompañante.
  momentos       String[] @default([])

  /// Imagen de referencia guardada en la propia base (no en disco ni en un CDN).
  /// Se sirve por GET /recetas/:id/imagen. Es nullable porque no toda receta
  /// consigue una foto con licencia reutilizable.
  imagenDatos    Bytes?   @map("imagen_datos")
  imagenMime     String?  @map("imagen_mime")
  imagenAncho    Int?     @map("imagen_ancho")
  imagenAlto     Int?     @map("imagen_alto")
  imagenBytes    Int?     @map("imagen_bytes")
  imagenFuente   String?  @map("imagen_fuente")
  imagenAutor    String?  @map("imagen_autor")
  imagenLicencia String?  @map("imagen_licencia")
  imagenQuery    String?  @map("imagen_query")
  imagenTitulo   String?  @map("imagen_titulo")

  categoria  Categoria   @relation(fields: [categoriaId], references: [id])
  favoritos  Favorito[]
  historial  Historial[]

  @@index([categoriaId])
  @@index([momentos], type: Gin)
  @@map("recetas")
}

// Vistas de "recetas" filtradas por categoría (migración
// 20261018210000_add_vistas_recetas_por_categoria). Solo sirven para revisar
// y editar con más orden, p. ej. en Prisma Studio: un cambio aquí se guarda en
// la fila real de "recetas". Prisma no crea vistas en las migraciones, así que
// si cambia una columna de Receta hay que actualizar el SQL a mano.

view RecetaDesayuno {
  id             Int     @unique
  categoriaId    Int     @map("categoria_id")
  nombre         String
  descripcion    String?
  ingredientes   Json
  preparacion    Json
  tiempoMinutos  Int?    @map("tiempo_minutos")
  dificultad     String?
  imagenAsset    String? @map("imagen_asset")
  bebida         String?
  acompanamiento String?
  videoUrl       String? @map("video_url")

  @@map("recetas_desayuno")
}

view RecetaAlmuerzo {
  id             Int     @unique
  categoriaId    Int     @map("categoria_id")
  nombre         String
  descripcion    String?
  ingredientes   Json
  preparacion    Json
  tiempoMinutos  Int?    @map("tiempo_minutos")
  dificultad     String?
  imagenAsset    String? @map("imagen_asset")
  bebida         String?
  acompanamiento String?
  videoUrl       String? @map("video_url")

  @@map("recetas_almuerzo")
}

view RecetaBebida {
  id             Int     @unique
  categoriaId    Int     @map("categoria_id")
  nombre         String
  descripcion    String?
  ingredientes   Json
  preparacion    Json
  tiempoMinutos  Int?    @map("tiempo_minutos")
  dificultad     String?
  imagenAsset    String? @map("imagen_asset")
  bebida         String?
  acompanamiento String?
  videoUrl       String? @map("video_url")

  @@map("recetas_bebidas")
}

// Vistas de la migración 20261019010000_add_vistas_cena_y_bebidas_por_momento:
// las cenas, y las bebidas separadas por el momento del día en que salen como
// acompañante. Una bebida de varios momentos aparece en varias de estas vistas.

view RecetaCena {
  id             Int     @unique
  categoriaId    Int     @map("categoria_id")
  nombre         String
  descripcion    String?
  ingredientes   Json
  preparacion    Json
  tiempoMinutos  Int?    @map("tiempo_minutos")
  dificultad     String?
  imagenAsset    String? @map("imagen_asset")
  bebida         String?
  acompanamiento String?
  videoUrl       String? @map("video_url")

  @@map("recetas_cena")
}

view RecetaBebidaDesayuno {
  id             Int     @unique
  categoriaId    Int     @map("categoria_id")
  nombre         String
  descripcion    String?
  ingredientes   Json
  preparacion    Json
  tiempoMinutos  Int?    @map("tiempo_minutos")
  dificultad     String?
  imagenAsset    String? @map("imagen_asset")
  bebida         String?
  acompanamiento String?
  videoUrl       String? @map("video_url")
  momentos       String[]

  @@map("recetas_bebidas_desayuno")
}

view RecetaBebidaAlmuerzo {
  id             Int     @unique
  categoriaId    Int     @map("categoria_id")
  nombre         String
  descripcion    String?
  ingredientes   Json
  preparacion    Json
  tiempoMinutos  Int?    @map("tiempo_minutos")
  dificultad     String?
  imagenAsset    String? @map("imagen_asset")
  bebida         String?
  acompanamiento String?
  videoUrl       String? @map("video_url")
  momentos       String[]

  @@map("recetas_bebidas_almuerzo")
}

view RecetaBebidaCena {
  id             Int     @unique
  categoriaId    Int     @map("categoria_id")
  nombre         String
  descripcion    String?
  ingredientes   Json
  preparacion    Json
  tiempoMinutos  Int?    @map("tiempo_minutos")
  dificultad     String?
  imagenAsset    String? @map("imagen_asset")
  bebida         String?
  acompanamiento String?
  videoUrl       String? @map("video_url")
  momentos       String[]

  @@map("recetas_bebidas_cena")
}

model Usuario {
  id             Int      @id @default(autoincrement())
  nombre         String
  email          String   @unique
  fotoUrl        String?  @map("foto_url")
  googleId       String?  @unique @map("google_id")
  fechaRegistro  DateTime @default(now()) @map("fecha_registro") @db.Timestamptz

  favoritos     Favorito[]
  historial     Historial[]
  refreshTokens RefreshToken[]

  @@map("usuarios")
}

model Favorito {
  id             Int      @id @default(autoincrement())
  usuarioId      Int      @map("usuario_id")
  recetaId       Int      @map("receta_id")
  fechaGuardado  DateTime @default(now()) @map("fecha_guardado") @db.Timestamptz

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  receta  Receta  @relation(fields: [recetaId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, recetaId])
  @@map("favoritos")
}

model Historial {
  id        Int      @id @default(autoincrement())
  usuarioId Int      @map("usuario_id")
  recetaId  Int      @map("receta_id")
  fecha     DateTime @default(now()) @db.Timestamptz

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  receta  Receta  @relation(fields: [recetaId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("historial")
}

/// Tabla nueva (no está en el schema.sql original de Huebito_JS).
/// Guarda solo el HASH del refresh token, nunca el token en claro, para
/// poder revocar/rotar sesiones sin exponer nada útil si la BD se filtra.
model RefreshToken {
  id                  String    @id @default(uuid())
  usuarioId           Int       @map("usuario_id")
  tokenHash           String    @unique @map("token_hash")
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz
  revokedAt           DateTime? @map("revoked_at") @db.Timestamptz
  replacedByTokenHash String?   @map("replaced_by_token_hash")
  userAgent           String?   @map("user_agent")
  ip                  String?
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("refresh_tokens")
}
